              }
             }
            }
           }
          }
         },
         "next": {
          "block": {
           "type": "nb_train",
           "fields": {
            "MODEL": "reader",
            "DATA": "reviews"
           },
           "inputs": {
            "SETTINGS": {
             "block": {
              "type": "nb_t_epochs",
              "inputs": {
               "N": {
                "shadow": {
                 "type": "math_number",
                 "fields": {
                  "NUM": 6
                 }
                }
               }
              },
              "next": {
               "block": {
                "type": "nb_t_batch",
                "inputs": {
