{
 "format": "neuroblocks-project",
 "version": 1,
 "name": "Invent new names (build a GPT from layers)",
 "description": "The same idea as GPT, but built from individual layer blocks: the 'repeat' block sets how many transformer layers there are. It learns from 32,000 first names and invents new ones.",
 "category": "Language models",
 "level": "intermediate",
 "minutes": 2,
 "order": 22,
 "id": "10_names",
