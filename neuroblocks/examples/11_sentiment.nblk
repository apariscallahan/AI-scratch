{
 "format": "neuroblocks-project",
 "version": 1,
 "name": "Is this review positive? (text classifier)",
 "description": "A small transformer reads short reviews and decides if they are positive or negative — including tricky ones like 'not boring at all'. Then type your own.",
 "category": "Language models",
 "level": "beginner",
 "minutes": 1,
 "order": 23,
 "id": "11_sentiment",
