                  "shadow": {
                   "type": "math_number",
                   "fields": {
                    "NUM": 32
                   }
                  }
                 }
                },
                "next": {
                 "block": {
                  "type": "nb_t_optimizer",
                  "fields": {
                   "OPT": "adam"
                  },
                  "inputs": {
                   "LR": {
                    "shadow": {
                     "type": "math_number",
                     "fields": {
                      "NUM": 0.003
                     }
                    }
                   }
                  }
                 }
                }
               }
              }
             }
            }
           },
           "next": {
            "block": {
             "type": "nb_evaluate",
             "fields": {
