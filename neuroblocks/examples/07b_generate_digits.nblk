{
 "format": "neuroblocks-project",
 "version": 1,
 "name": "Draw new digits (generative AI)",
 "description": "A picture generator studies 60,000 handwritten digits and learns to invent brand-new ones — you can even ask it for a particular digit. Watch the pictures sharpen while it trains.",
 "category": "Images",
 "level": "intermediate",
 "minutes": 4,
 "order": 13,
 "id": "07b_generate_digits",
 "workspace": {
  "blocks": {
   "languageVersion": 0,
   "blocks": [
    {
     "type": "nb_when_run",
     "next": {
      "block": {
       "type": "nb_data_images",
       "fields": {
        "NAME": "mnist",
        "KIND": "mnist"
       },
       "next": {
        "block": {
         "type": "nb_gen_create",
         "fields": {
          "NAME": "artist",
          "KIND": "vae"
         },
         "next": {
          "block": {
           "type": "nb_train",
           "fields": {
            "MODEL": "artist",
            "DATA": "mnist"
           },
           "inputs": {
            "SETTINGS": {
             "block": {
              "type": "nb_t_epochs",
              "inputs": {
               "N": {
                "shadow": {
                 "type": "math_number",
                 "fields": {
                  "NUM": 8
                 }
                }
               }
              },
              "next": {
               "block": {
                "type": "nb_t_batch",
                "inputs": {
                 "N": {
                  "shadow": {
                   "type": "math_number",
                   "fields": {
                    "NUM": 128
                   }
                  }
                 }
                }
               }
              }
             }
            }
           },
           "next": {
            "block": {
             "type": "nb_gen_show",
             "fields": {
              "MODEL": "artist"
             },
             "inputs": {
              "N": {
               "shadow": {
                "type": "math_number",
                "fields": {
                 "NUM": 32
                }
               }
              },
              "CLASS": {
               "shadow": {
                "type": "text",
                "fields": {
                 "TEXT": "any"
                }
               },
               "block": {
                "type": "text",
                "fields": {
                 "TEXT": "any"
                }
               }
              }
             },
             "next": {
              "block": {
               "type": "nb_save",
               "fields": {
                "MODEL": "artist"
               },
               "inputs": {
                "FILE": {
                 "shadow": {
                  "type": "text",
                  "fields": {
                   "TEXT": "my_model.pt"
                  }
                 },
                 "block": {
                  "type": "text",
                  "fields": {
                   "TEXT": "digit_artist.pt"
                  }
                 }
                }
               },
               "next": {
                "block": {
                 "type": "nb_weights",
                 "id": "weights",
                 "fields": {
                  "MODEL": "artist"
                 }
                }
               }
              }
             }
            }
           }
          }
         }
        }
       }
      }
     },
     "x": 40,
     "y": 40
    },
    {
     "type": "nb_when_output",
     "id": "output",
     "fields": {
      "PORT": "weights"
     },
     "next": {
      "block": {
       "type": "variables_set",
       "fields": {
        "VAR": {
         "name": "noise"
        }
       },
       "inputs": {
        "VALUE": {
         "block": {
          "type": "nb_o_noise"
         }
        }
       },
       "next": {
        "block": {
         "type": "controls_for",
         "fields": {
          "VAR": {
           "name": "digit"
          }
         },
         "inputs": {
          "FROM": {
           "block": {
            "type": "math_number",
            "fields": {
             "NUM": 0
            }
           }
          },
          "TO": {
           "block": {
            "type": "math_number",
            "fields": {
             "NUM": 9
            }
           }
          },
          "BY": {
           "block": {
            "type": "math_number",
            "fields": {
             "NUM": 1
            }
           }
          },
          "DO": {
           "block": {
            "type": "nb_o_show_pic",
            "inputs": {
             "PIC": {
              "block": {
               "type": "nb_o_picture",
               "inputs": {
                "NOISE": {
                 "block": {
                  "type": "variables_get",
                  "fields": {
                   "VAR": {
                    "name": "noise"
                   }
                  }
                 }
                },
                "CLASS": {
                 "shadow": {
                  "type": "text",
                  "fields": {
                   "TEXT": "any"
                  }
                 },
                 "block": {
                  "type": "variables_get",
                  "fields": {
                   "VAR": {
                    "name": "digit"
                   }
                  }
                 }
                }
               }
              }
             }
            }
           }
          }
         },
         "next": {
          "block": {
           "type": "nb_say",
           "inputs": {
            "TEXT": {
             "shadow": {
              "type": "text",
              "fields": {
               "TEXT": "Hello!"
              }
             },
             "block": {
              "type": "text",
              "fields": {
               "TEXT": "Same noise, ten different digits: the noise decides the handwriting style. Run again for new noise!"
              }
             }
            }
           }
          }
         }
        }
       }
      }
